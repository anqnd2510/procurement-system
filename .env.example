# Environment Variables Example
# Copy this file to .env and update with your values

# Local API process connects to the Compose database through the loopback port.
DATABASE_URL="postgresql://procurement:local-development-only@localhost:5433/procurement?schema=public"
POSTGRES_USER=procurement
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=procurement
POSTGRES_HOST_PORT=5433

# JWT
JWT_SECRET="replace-with-a-long-random-secret"

# Server
PORT=8081
NODE_ENV=development
API_HOST_PORT=8081
FRONTEND_HOST_PORT=8082

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=local-development-only
REDIS_DB=0
REDIS_HOST_PORT=6380
